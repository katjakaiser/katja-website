# YouTube Video Automation - Umgebungsvariablen
# =============================================
# Kopiere diese Datei nach .env und fülle die Werte aus

# === Anthropic Claude API (für Skript-Optimierung) ===
# API Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude Modell (Standard: claude-sonnet-4-20250514)
LLM_MODEL=claude-sonnet-4-20250514

# === ElevenLabs Voice Cloning ===
# API Key: https://elevenlabs.io/api
ELEVENLABS_API_KEY=...

# Voice ID deiner geklonten Stimme (wird nach dem Klonen angezeigt)
# EINMALIG klonen, dann monatliche Nutzung nach Zeichen
ELEVENLABS_VOICE_ID=...

# Voice Settings (0.0 - 1.0)
VOICE_STABILITY=0.5
VOICE_SIMILARITY_BOOST=0.75
VOICE_STYLE=0.0

# === YouTube API ===
# Client Secrets JSON Datei von Google Cloud Console
# Anleitung: https://developers.google.com/youtube/v3/getting-started
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CREDENTIALS_FILE=youtube_credentials.json

# YouTube Default Settings
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_DEFAULT_LANGUAGE=de

# === Video Settings ===
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# === Skript Settings ===
DEFAULT_VIDEO_LENGTH_MINUTES=10
DEFAULT_LANGUAGE=de

# === Brand Settings ===
BRAND_NAME=Katja Kaiser Coaching
BRAND_TAGLINE=Executive Performance, Leadership & Breathwork
